VITE_API_BASE_URL=https://localhost:7210
VITE_OPENAPI_PATH=/swagger/v1/swagger.json

# Authentication
VITE_ROUTE_AUTHENTICATION_LOGIN_POST=/api/Authentication/login

# Dashboard and reports
VITE_ROUTE_DASHBOARD_SUMMARY_GET=/api/Dashboard/summary
VITE_ROUTE_REPORT_REPORT_GET=/api/Report/dashboard

# Customers and insurance
VITE_ROUTE_CUSTOMER_COLLECTION_GET=/api/Customer
VITE_ROUTE_POLICY_COLLECTION_GET=/api/Policy
VITE_ROUTE_INSURANCECOMPANY_COLLECTION_GET=/api/InsuranceCompany
VITE_ROUTE_INSURANCEPLAN_COLLECTION_GET=/api/InsurancePlan

# Payments, renewals, and claims
VITE_ROUTE_PREMIUMPAYMENT_COLLECTION_GET=/api/PremiumPayment
VITE_ROUTE_POLICYRENEWAL_COLLECTION_GET=/api/PolicyRenewal
VITE_ROUTE_CLAIM_COLLECTION_GET=/api/Claim

# Administration
VITE_ROUTE_AGENT_COLLECTION_GET=/api/Agent
VITE_ROUTE_NOTIFICATION_COLLECTION_GET=/api/Notification
VITE_ROUTE_SETTINGS_COLLECTION_GET=/api/Settings